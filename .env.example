# Environment Configuration Template for Sealand OOG Route Assistant
# Copy this file to .env and configure your production values

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=windmill
DB_SSLMODE=disable

# Windmill Configuration
WMILL_URL=http://localhost:8080
WMILL_WORKSPACE=demo
WMILL_TOKEN=your_windmill_api_token_here

# n8n Sensor & Notification Webhooks
N8N_BASE_URL=https://n8n.your-domain.com/api/v1
N8N_API_KEY=your_n8n_api_key_here
N8N_WEBHOOK_INGESTION_URL=https://n8n.your-domain.com/webhook/oog-survey-request
N8N_WEBHOOK_NOTIFICATION_URL=https://n8n.your-domain.com/webhook/oog-permit-notification

# Application Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

